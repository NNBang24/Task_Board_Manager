generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //  url      = env("DATABASE_URL")
}
enum VoiceLogStatus {
  SUCCESS
  PARSED   
  FAILED  
}
enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Profession {
  DEV
  TESTER
  DESIGNER
  BA
  MARKETING
  DEVOPS
  PRODUCT_OWNER
}

enum UserStatusSignal {
  ONLINE
  BUSY
  IN_MEETING
  AWAY
  OFFLINE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PAUSED
  BLOCKED
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  IMPORTANT
  URGENT
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  MISSED
  COMPLETED
  REJECTED
  BUSY
}

enum WorkMode {
  OFFICE
  REMOTE
}

enum WorkType {
  OFFICE
  WFH
  ON_SITE
  LEAVE
}

enum WorkShift {
  FULL_DAY
  MORNING
  AFTERNOON
}

enum LeaveType {
  WFH
  ANNUAL_LEAVE
  SICK_LEAVE
  UNPAID_LEAVE
  MATERNITY_LEAVE
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  APPROVED_MODIFIED
  REJECTED
  CANCELLED
}

enum TaskRequestType {
  TRANSFER
  ASSIST
  REVIEW
  SUBTASK_APPROVAL
}

enum TaskRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  SUBTASK_URGENT
  SUBTASK_APPROVAL_REQUEST
  SUBTASK_APPROVED
  SUBTASK_REJECTED
  TASK_TRANSFER_REQUEST
  TASK_TRANSFER_ACCEPTED
  TASK_TRANSFER_REJECTED
  TASK_COMMENT
  MENTION
  SYSTEM
  LEAVE_REQUEST_SUBMITTED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  WORK_SCHEDULE_ASSIGNED
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users    User[]
  projects ProjectDepartment[]

  @@map("departments")
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  password     String?
  fullName     String           @map("full_name")
  avatar       String?
  coverImage   String?          @map("cover_image")
  googleId     String?          @unique @map("google_id")
  role         Role             @default(EMPLOYEE)
  profession   Profession       @default(DEV)
  jobTitle     String?          @map("job_title")
  phone        String?
  bio          String?
  isActive     Boolean          @default(true) @map("is_active")
  isFirstLogin Boolean          @default(false) @map("is_first_login")
  statusSignal UserStatusSignal @default(ONLINE) @map("status_signal")
  customStatus String?          @map("custom_status")
  refreshToken String?          @map("refresh_token")
  departmentId String?          @map("department_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  department             Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownedProjects          Project[]       @relation("ProjectOwner")
  managedProjects        Project[]       @relation("ProjectManager")
  memberships            ProjectMember[]
  assignedTasks          Task[]          @relation("TaskAssignee")
  createdTasks           Task[]          @relation("TaskCreator")
  comments               Comment[]
  sentDirectMessages     DirectMessage[] @relation("SentMessages")
  receivedDirectMessages DirectMessage[] @relation("ReceivedMessages")
  sentCalls              CallLog[]       @relation("SentCalls")
  receivedCalls          CallLog[]       @relation("ReceivedCalls")
  sentTaskRequests       TaskRequest[]   @relation("SentTaskRequests")
  receivedTaskRequests   TaskRequest[]   @relation("ReceivedTaskRequests")
  assignedSubtasks       Subtask[]       @relation("SubtaskAssignee")
  notifications          Notification[]  @relation("UserNotifications")
  actorNotifications     Notification[]  @relation("ActorNotifications")
  taskHistories          TaskHistory[]
  workSchedules          WorkSchedule[]  @relation("UserWorkSchedules")
  createdWorkSchedules   WorkSchedule[]  @relation("CreatedWorkSchedules")
  leaveRequests          LeaveRequest[]  @relation("UserLeaveRequests")
  approvedLeaveRequests  LeaveRequest[]  @relation("ApprovedLeaveRequests")
  voiceLogs              VoiceCommandLog[]

  @@map("users")
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  isCompleted Boolean   @default(false) @map("is_completed")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")
  managerId   String?   @map("manager_id")
  createdById String    @map("created_by_id")
  stagesJson  String?   @map("stages_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy   User                @relation("ProjectOwner", fields: [createdById], references: [id], onDelete: Cascade)
  manager     User?               @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  departments ProjectDepartment[]
  members     ProjectMember[]
  tasks       Task[]
  tags        Tag[]
  voiceLogs   VoiceCommandLog[]

  @@index([isDeleted])
  @@map("projects")
}

model ProjectDepartment {
  projectId    String @map("project_id")
  departmentId String @map("department_id")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([projectId, departmentId])
  @@map("project_departments")
}

model ProjectMember {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(NORMAL)
  progress       Int          @default(0)
  startDate      DateTime?    @map("start_date")
  dueDate        DateTime?    @map("due_date")
  recurrenceRule String?      @map("recurrence_rule")
  rawVoice       String?      @map("raw_voice")
  isArchived     Boolean      @default(false) @map("is_archived")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  deletedAt      DateTime?    @map("deleted_at")
  completedAt    DateTime?    @map("completed_at")
  projectId      String       @map("project_id")
  assigneeId     String?      @map("assignee_id")
  createdById    String       @map("created_by_id")
  stageId        String?      @map("stage_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  subtasks      Subtask[]
  tags          TaskTag[]
  comments      Comment[]
  taskRequests  TaskRequest[]
  attachments   Attachment[]
  notifications Notification[]
  histories     TaskHistory[]
  voiceLogs      VoiceCommandLog[] 

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([createdById])
  @@index([status])
  @@index([isArchived])
  @@map("tasks")
}

model Subtask {
  id              String    @id @default(uuid())
  taskId          String    @map("task_id")
  title           String
  isDone          Boolean   @default(false) @map("is_done")
  isUrgent        Boolean   @default(false) @map("is_urgent")
  approvalStatus  String    @default("APPROVED") @map("approval_status")
  rejectionReason String?   @map("rejection_reason")
  order           Int       @default(0)
  assigneeId      String?   @map("assignee_id")
  startDate       DateTime? @map("start_date")
  estimatedDays   Int       @default(1) @map("estimated_days")
  dueDate         DateTime? @map("due_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User? @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("subtasks")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String?
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("comments")
}

model DirectMessage {
  id         String   @id @default(uuid())
  content    String
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}

model CallLog {
  id         String     @id @default(uuid())
  callerId   String     @map("caller_id")
  receiverId String     @map("receiver_id")
  type       CallType   @default(AUDIO)
  status     CallStatus @default(COMPLETED)
  duration   Int        @default(0)
  startedAt  DateTime   @default(now()) @map("started_at")
  endedAt    DateTime?  @map("ended_at")

  caller   User @relation("SentCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedCalls", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("call_logs")
}

model TaskRequest {
  id           String            @id @default(uuid())
  taskId       String            @map("task_id")
  senderId     String            @map("sender_id")
  receiverId   String            @map("receiver_id")
  type         TaskRequestType   @default(TRANSFER)
  status       TaskRequestStatus @default(PENDING)
  note         String?
  responseNote String?           @map("response_note")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender   User @relation("SentTaskRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedTaskRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([taskId, status])
  @@map("task_requests")
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String // 'file' or 'link'
  size      String?
  taskId    String   @map("task_id")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  actorId   String?          @map("actor_id")
  title     String
  content   String
  type      NotificationType @default(SYSTEM)
  taskId    String?          @map("task_id")
  subtaskId String?          @map("subtask_id")
  projectId String?          @map("project_id")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_histories")
}
model VoiceCommandLog {
  id               String         @id @default(uuid())
  userId           String         @map("user_id")
  rawAudioText     String         @map("raw_audio_text")   
  intent           String?                                 
  parsedJson       String?        @map("parsed_json")      
  status           VoiceLogStatus @default(PARSED)
  processingTimeMs Int?           @map("processing_time_ms") 
  projectId        String?        @map("project_id")       
  taskId           String?        @map("task_id")          
  errorMessage     String?        @map("error_message")
  createdAt        DateTime       @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@map("voice_command_logs")
}

model WorkSchedule {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  date           DateTime  @db.Date
  workType       WorkType  @default(OFFICE) @map("work_type")
  shift          WorkShift @default(FULL_DAY)
  note           String?
  createdById    String?   @map("created_by_id")
  leaveRequestId String?   @map("leave_request_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User          @relation("UserWorkSchedules", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("CreatedWorkSchedules", fields: [createdById], references: [id], onDelete: SetNull)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@unique([userId, date, shift])
  @@index([userId, date])
  @@index([date, workType])
  @@map("work_schedules")
}

model LeaveRequest {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  type              LeaveType   @default(WFH)
  startDate         DateTime    @map("start_date") @db.Date
  endDate           DateTime    @map("end_date") @db.Date
  shift             WorkShift   @default(FULL_DAY)
  reason            String
  status            LeaveStatus @default(PENDING)
  handoverPlan      String?     @map("handover_plan")
  approverId        String?     @map("approver_id")
  responseNote      String?     @map("response_note")
  approvedStartDate DateTime?   @map("approved_start_date") @db.Date
  approvedEndDate   DateTime?   @map("approved_end_date") @db.Date
  modifiedTasksPlan String?     @map("modified_tasks_plan")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user          User           @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  approver      User?          @relation("ApprovedLeaveRequests", fields: [approverId], references: [id], onDelete: SetNull)
  workSchedules WorkSchedule[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("leave_requests")
}
